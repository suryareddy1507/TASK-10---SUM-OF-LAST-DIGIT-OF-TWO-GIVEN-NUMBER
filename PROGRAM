import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        int lastDigit1 = Math.abs(a % 10);
        int lastDigit2 = Math.abs(b % 10);

        System.out.println(lastDigit1 + lastDigit2);

        sc.close();
    }
}
